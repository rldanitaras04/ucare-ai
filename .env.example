# Supabase Configuration
# Copy this file to .env.local and fill in the values
#
# IMPORTANT: NEXT_PUBLIC_SUPABASE_URL must be the Supabase API URL (https://xxx.supabase.co)
# NOT the direct database connection string (postgresql://...)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (for admin operations like user management)
# This key bypasses RLS - NEVER expose to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
